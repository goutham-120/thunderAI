# ==========================================
# VAJRA-AI — Data Ingestion & NWP Configuration
# ==========================================

# Keep synthetic until the real connector is tested end-to-end
DATA_MODE=synthetic

# ==========================================
# OPEN-METEO ECMWF NWP CONNECTOR
# ==========================================

OPEN_METEO_API_URL=https://api.open-meteo.com/v1/ecmwf

# Open-Meteo does NOT require an API key for this normal endpoint
OPEN_METEO_API_KEY=

# Visakhapatnam region
OPEN_METEO_LAT=17.68014
OPEN_METEO_LON=83.204254

OPEN_METEO_VARIABLES=temperature_2m,relative_humidity_2m,dew_point_2m,precipitation,cloud_cover,wind_speed_10m,wind_speed_100m,wind_speed_200m,cape,convective_inhibition,total_column_integrated_water_vapour

OPEN_METEO_TIMEOUT_SEC=15
OPEN_METEO_MAX_RETRIES=3

# ==========================================
# MOSDAC — SATELLITE DATA
# ==========================================

MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_API_URL=
MOSDAC_DATASET_ID=GSMaP_ISRO_RAIN
MOSDAC_REQUEST_TIMEOUT_SEC=30
MOSDAC_MAX_RETRIES=3

# ==========================================
# NCMRWF — ADDITIONAL NWP DATA
# ==========================================

NCMRWF_USERNAME=
NCMRWF_PASSWORD=
NCMRWF_API_URL=
NCMRWF_DATASET_ID=

# ==========================================
# IMD — KEEP EMPTY / DISABLED FOR NOW
# ==========================================

IMD_AWS_API_URL=
IMD_RADAR_API_URL=
IMD_LIGHTNING_API_URL=
IMD_API_KEY=
IMD_AUTH_TOKEN=

# ==========================================
# FALLBACK / SYSTEM SETTINGS
# ==========================================

REQUEST_TIMEOUT_SEC=15
MAX_RETRIES=3
ALLOW_SYNTHETIC_FALLBACK=true